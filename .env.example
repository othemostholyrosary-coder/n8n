# Public hostname served by Cloudflare Worker
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n.example.com/
WEBHOOK_URL=https://n8n.example.com/
N8N_SECURE_COOKIE=true

# Generate once: openssl rand -hex 32. Never rotate after data is stored.
N8N_ENCRYPTION_KEY=replace_with_64_hex_characters

# Supabase Postgres
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=db.your-project-ref.supabase.co
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=replace_with_supabase_password
DB_POSTGRESDB_SSL_ENABLED=true

# Runtime
N8N_RUNNERS_ENABLED=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
GENERIC_TIMEZONE=Europe/London
TZ=Europe/London

# Optional legacy basic auth; n8n owner setup is preferred on current versions.
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=replace_with_admin_username
# N8N_BASIC_AUTH_PASSWORD=replace_with_strong_password
